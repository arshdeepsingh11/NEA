# Public site URL (used for sitemap, canonical URLs and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://neaprecisionskin.com
# Optional: forward form leads (skin scan, consultation, partner) to a webhook (Zapier, Make, CRM)
LEAD_WEBHOOK_URL=
# NEA SI engines (server only). See README → "NEA SI". Without them the built-in engine answers.
XEVYO_API_KEY=
XEVYO_API_URL=https://chat.xevyo.com/xevyo/v1
XEVYO_MODEL=xevyo
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash
# Speed: start the next model in parallel every GEMINI_HEDGE_MS without an answer; give up after GEMINI_FIRST_TOKEN_MS
GEMINI_HEDGE_MS=1500
GEMINI_FIRST_TOKEN_MS=9000
SI_DEFAULT_ENGINE=xevyo
# Optional: add new Instagram Reels to the site automatically (free, official Instagram API). See README → "Reels".
INSTAGRAM_ACCESS_TOKEN=
# Optional: protects /api/instagram/refresh (Vercel sends it automatically to cron jobs)
CRON_SECRET=
