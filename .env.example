# Public site URL (used for sitemap, canonical URLs and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://neaprecisionskin.com
# Optional: forward form leads (skin scan, consultation, partner) to a webhook (Zapier, Make, CRM)
LEAD_WEBHOOK_URL=
# Optional: connect "Ask NEA" to an LLM later. Without it, the built-in knowledge engine answers.
AI_API_KEY=
# Optional: add new Instagram Reels to the site automatically (free, official Instagram API). See README → "Reels".
INSTAGRAM_ACCESS_TOKEN=
# Optional: protects /api/instagram/refresh (Vercel sends it automatically to cron jobs)
CRON_SECRET=
